{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["es2020"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["index.js", "App.tsx", "src/**/*"],
  "exclude": ["node_modules", "babel.config.js", "metro.config.js", "scripts"]
}
